    "_Windows": {
      "type": "panel",
      "label": {
        "en": "Windows",
        "de": "Fenster"
      },
      "items": {
        "windows": {
          "label": {
            "en": "Windows",
            "de": "Fenster"
          },
          "sm": 12,
          "type": "accordion",
          "titleAttr": "name",
          "xs": 12,
          "items": [
            {
              "attr": "id",
              "type": "text",
              "default": "",
              "label": {
                "en": "Window ID",
                "de": "Fenster-ID"
              },
              "xs": 12,
              "sm": 6,
              "newLine": true
            },
            {
              "attr": "name",
              "type": "text",
              "default": "",
              "label": {
                "en": "Window name",
                "de": "Fenstername"
              },
              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "enabled",
              "type": "checkbox",
              "default": true,
