              },
              "xs": 12,
              "sm": 12,
              "newLine": true
            },
            {
              "attr": "roomTemperatureState",
              "type": "objectId",
              "default": "",
              "label": {
                "en": "Room temperature state",
                "de": "Datenpunkt für die Raumtemperatur"
              },
              "xs": 12,
              "sm": 12,
              "newLine": true
            },
            {
              "attr": "contactState",
