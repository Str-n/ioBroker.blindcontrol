              "default": "blockClosing",
              "options": [
                {
                  "label": "ignore",
                  "value": "ignore"
                },
                {
                  "label": "blockClosing",
                  "value": "blockClosing"
                },
                {
                  "label": "forceOpenWhileOpen",
                  "value": "forceOpenWhileOpen"
                }
              ],
              "label": {
                "en": "Contact safety mode",
                "de": "Sicherheitsmodus des Kontakts"
              },
              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "contactOpenValue",
              "type": "text",
              "default": "true",
              "label": {
                "en": "Contact value when open",
                "de": "Kontaktwert bei geöffnetem Fenster"
