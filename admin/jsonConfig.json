              },
              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "sunElevationMin",
              "type": "number",
              "default": "",
              "label": {
                "en": "Minimum sun elevation (°, optional)",
                "de": "Minimale Sonnenhöhe (°, optional)"
              },
              "xs": 12,
              "sm": 6,
              "newLine": true
            },
            {
              "attr": "sunElevationMax",
              "type": "number",
              "default": "",
              "label": {
                "en": "Maximum sun elevation (°, optional)",
                "de": "Maximale Sonnenhöhe (°, optional)"
              },
              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "autoOpenMorning",
              "type": "checkbox",
              "default": false,
              "label": {
                "en": "Initially open automatically in the morning",
                "de": "Anfangs morgens automatisch öffnen"
              },
              "xs": 12,
              "sm": 6,
              "newLine": true
            },
            {
              "attr": "morningOpenPosition",
              "type": "number",
              "default": 100,
              "label": {
                "en": "Morning opening position (%)",
                "de": "Öffnungsposition am Morgen (%)"
              },
              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "temperatureOffset",
              "type": "number",
              "default": 0,
              "label": {
                "en": "Room temperature correction (°C)",
