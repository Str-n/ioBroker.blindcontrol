              "xs": 12,
              "sm": 6,
              "newLine": true
            },
            {
              "attr": "sunAzimuthMin",
              "type": "number",
              "default": "",
              "label": {
                "en": "Minimum sun azimuth (°, optional)",
                "de": "Minimaler Sonnenazimut (°, optional)"
