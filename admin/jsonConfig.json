              "xs": 12,
              "sm": 6,
              "newLine": false
            },
            {
              "attr": "contactClosedValue",
              "type": "text",
              "default": "false",
              "label": {
                "en": "Contact value when closed",
                "de": "Kontaktwert bei geschlossenem Fenster"
